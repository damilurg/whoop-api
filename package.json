{
  "name": "whoop-analytics-agents",
  "version": "1.0.0",
  "description": "Система агентов для анализа данных WHOOP с визуализацией",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsup src/main.ts --format cjs,esm --dts",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "auth": "tsx src/agents/auth/whoopAuthAgent.ts",
    "fetch": "tsx src/agents/api/dataFetchAgent.ts",
    "normalize": "tsx src/agents/data/normalizationAgent.ts",
    "charts": "tsx src/agents/charts/chartRenderAgent.ts",
    "report": "tsx src/agents/report/reportAgent.ts"
  },
  "keywords": ["whoop", "analytics", "agents", "typescript", "charts"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "d3": "^7.8.5",
    "jsdom": "^23.0.1",
    "puppeteer": "^21.5.0",
    "pdfkit": "^0.14.0",
    "handlebars": "^4.7.8",
    "date-fns": "^2.30.0",
    "@abandonware/noble": "^1.9.2-15",
    "cli-table3": "^0.6.3",
    "chalk": "^4.1.2",
    "inquirer": "^8.2.6"
  },
  "devDependencies": {
    "@types/node": "^20.8.0",
    "@types/inquirer": "^9.0.3",
    "@types/pdfkit": "^0.12.12",
    "typescript": "^5.2.0",
    "tsx": "^3.14.0",
    "tsup": "^7.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}