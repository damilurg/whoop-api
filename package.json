{
  "name": "whoop-analytics-agents",
  "version": "1.0.0",
  "description": "Advanced WHOOP Analytics System with BLE Integration and Web Dashboard",
  "main": "dist/main.js",
  "type": "module",
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/main.ts",
    "start": "node dist/main.js",
    "dashboard": "tsx src/web/server.ts",
    "build:web": "cd src/web/client && npm run build",
    "dev:web": "concurrently \"tsx src/web/server.ts\" \"cd src/web/client && npm run dev\"",
    "type-check": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test": "vitest"
  },
  "keywords": [
    "whoop",
    "analytics",
    "health",
    "fitness",
    "api",
    "ble",
    "dashboard",
    "typescript"
  ],
  "author": "WHOOP Analytics Team",
  "license": "MIT",
  "dependencies": {
    "axios": "^1.6.0",
    "dotenv": "^16.3.1",
    "d3": "^7.8.5",
    "jsdom": "^23.0.1",
    "handlebars": "^4.7.8",
    "puppeteer": "^21.5.2",
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "ws": "^8.14.2",
    "multer": "^1.4.5-lts.1",
    "compression": "^1.7.4",
    "helmet": "^7.1.0",
    "morgan": "^1.10.0",
    "socket.io": "^4.7.4",
    "archiver": "^6.0.1",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.14.0",
    "csv-stringify": "^6.4.4",
    "dayjs": "^1.11.10",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.18.0",
    "recharts": "^2.8.0",
    "react-grid-layout": "^1.4.4",
    "react-datepicker": "^4.21.0",
    "react-select": "^5.8.0",
    "react-helmet": "^6.1.0",
    "styled-components": "^6.1.1",
    "framer-motion": "^10.16.5",
    "react-hot-toast": "^2.4.1",
    "react-icons": "^4.12.0",
    "react-intersection-observer": "^9.5.3",
    "react-virtualized-auto-sizer": "^1.0.20",
    "lucide-react": "^0.292.0",
    "@noble/hashes": "^1.3.3",
    "@abandonware/noble": "^1.9.2-15"
  },
  "devDependencies": {
    "@types/node": "^20.8.10",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/ws": "^8.5.9",
    "@types/multer": "^1.4.11",
    "@types/compression": "^1.7.5",
    "@types/morgan": "^1.9.9",
    "@types/archiver": "^6.0.2",
    "@types/pdfkit": "^0.12.12",
    "@types/react": "^18.2.37",
    "@types/react-dom": "^18.2.15",
    "@types/react-helmet": "^6.1.9",
    "@types/styled-components": "^5.1.32",
    "@vitejs/plugin-react": "^4.1.1",
    "typescript": "^5.2.2",
    "tsup": "^7.2.0",
    "tsx": "^4.1.0",
    "eslint": "^8.53.0",
    "@typescript-eslint/eslint-plugin": "^6.10.0",
    "@typescript-eslint/parser": "^6.10.0",
    "vitest": "^0.34.6",
    "concurrently": "^8.2.2",
    "vite": "^4.5.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}